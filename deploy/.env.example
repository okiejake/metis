# Copy to .env on the server and adjust. .env is never committed.

# Image to run, and the tag each environment follows.
METIS_IMAGE=ghcr.io/okiejake/metis
PROD_TAG=release
QA_TAG=main

# Path each environment is served under, and its local port. The paths must
# match the ones given to Tailscale Serve.
PROD_PATH=/metis_prod
PROD_PORT=8101
QA_PATH=/metis_qa
QA_PORT=8102

# Limits for a small server. METIS_MEM_LIMIT caps each container;
# METIS_DB_MEMORY_LIMIT caps the database inside it and should be well below.
METIS_MEM_LIMIT=256m
METIS_DB_MEMORY_LIMIT=96MB
METIS_DB_THREADS=1

# 1 when served over HTTPS (Tailscale Serve is). Set 0 only for plain HTTP.
METIS_SECURE_COOKIES=1

# Production backups kept by metis.sh.
KEEP_BACKUPS=14
